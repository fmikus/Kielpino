<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1200" height="630" fill="#F5F5DC"/>

  <!-- Chess board -->
  <g transform="translate(300, 100)">
    <!-- Board border -->
    <rect x="-10" y="-10" width="620" height="420" fill="#8B4513" stroke="#654321" stroke-width="5"/>

    <!-- Chess squares (8x8) -->
    <!-- Row 1 -->
    <rect x="0" y="0" width="75" height="50" fill="#DEB887"/>
    <rect x="75" y="0" width="75" height="50" fill="#8B4513"/>
    <rect x="150" y="0" width="75" height="50" fill="#DEB887"/>
    <rect x="225" y="0" width="75" height="50" fill="#8B4513"/>
    <rect x="300" y="0" width="75" height="50" fill="#DEB887"/>
    <rect x="375" y="0" width="75" height="50" fill="#8B4513"/>
    <rect x="450" y="0" width="75" height="50" fill="#DEB887"/>
    <rect x="525" y="0" width="75" height="50" fill="#8B4513"/>

    <!-- Row 2 -->
    <rect x="0" y="50" width="75" height="50" fill="#8B4513"/>
    <rect x="75" y="50" width="75" height="50" fill="#DEB887"/>
    <rect x="150" y="50" width="75" height="50" fill="#8B4513"/>
    <rect x="225" y="50" width="75" height="50" fill="#DEB887"/>
    <rect x="300" y="50" width="75" height="50" fill="#8B4513"/>
    <rect x="375" y="50" width="75" height="50" fill="#DEB887"/>
    <rect x="450" y="50" width="75" height="50" fill="#8B4513"/>
    <rect x="525" y="50" width="75" height="50" fill="#DEB887"/>

    <!-- Row 3 -->
    <rect x="0" y="100" width="75" height="50" fill="#DEB887"/>
    <rect x="75" y="100" width="75" height="50" fill="#8B4513"/>
    <rect x="150" y="100" width="75" height="50" fill="#DEB887"/>
    <rect x="225" y="100" width="75" height="50" fill="#8B4513"/>
    <rect x="300" y="100" width="75" height="50" fill="#DEB887"/>
    <rect x="375" y="100" width="75" height="50" fill="#8B4513"/>
    <rect x="450" y="100" width="75" height="50" fill="#DEB887"/>
    <rect x="525" y="100" width="75" height="50" fill="#8B4513"/>

    <!-- Row 4 -->
    <rect x="0" y="150" width="75" height="50" fill="#8B4513"/>
    <rect x="75" y="150" width="75" height="50" fill="#DEB887"/>
    <rect x="150" y="150" width="75" height="50" fill="#8B4513"/>
    <rect x="225" y="150" width="75" height="50" fill="#DEB887"/>
    <rect x="300" y="150" width="75" height="50" fill="#8B4513"/>
    <rect x="375" y="150" width="75" height="50" fill="#DEB887"/>
    <rect x="450" y="150" width="75" height="50" fill="#8B4513"/>
    <rect x="525" y="150" width="75" height="50" fill="#DEB887"/>

    <!-- Row 5 -->
    <rect x="0" y="200" width="75" height="50" fill="#DEB887"/>
    <rect x="75" y="200" width="75" height="50" fill="#8B4513"/>
    <rect x="150" y="200" width="75" height="50" fill="#DEB887"/>
    <rect x="225" y="200" width="75" height="50" fill="#8B4513"/>
    <rect x="300" y="200" width="75" height="50" fill="#DEB887"/>
    <rect x="375" y="200" width="75" height="50" fill="#8B4513"/>
    <rect x="450" y="200" width="75" height="50" fill="#DEB887"/>
    <rect x="525" y="200" width="75" height="50" fill="#8B4513"/>

    <!-- Row 6 -->
    <rect x="0" y="250" width="75" height="50" fill="#8B4513"/>
    <rect x="75" y="250" width="75" height="50" fill="#DEB887"/>
    <rect x="150" y="250" width="75" height="50" fill="#8B4513"/>
    <rect x="225" y="250" width="75" height="50" fill="#DEB887"/>
    <rect x="300" y="250" width="75" height="50" fill="#8B4513"/>
    <rect x="375" y="250" width="75" height="50" fill="#DEB887"/>
    <rect x="450" y="250" width="75" height="50" fill="#8B4513"/>
    <rect x="525" y="250" width="75" height="50" fill="#DEB887"/>

    <!-- Row 7 -->
    <rect x="0" y="300" width="75" height="50" fill="#DEB887"/>
    <rect x="75" y="300" width="75" height="50" fill="#8B4513"/>
    <rect x="150" y="300" width="75" height="50" fill="#DEB887"/>
    <rect x="225" y="300" width="75" height="50" fill="#8B4513"/>
    <rect x="300" y="300" width="75" height="50" fill="#DEB887"/>
    <rect x="375" y="300" width="75" height="50" fill="#8B4513"/>
    <rect x="450" y="300" width="75" height="50" fill="#DEB887"/>
    <rect x="525" y="300" width="75" height="50" fill="#8B4513"/>

    <!-- Row 8 -->
    <rect x="0" y="350" width="75" height="50" fill="#8B4513"/>
    <rect x="75" y="350" width="75" height="50" fill="#DEB887"/>
    <rect x="150" y="350" width="75" height="50" fill="#8B4513"/>
    <rect x="225" y="350" width="75" height="50" fill="#DEB887"/>
    <rect x="300" y="350" width="75" height="50" fill="#8B4513"/>
    <rect x="375" y="350" width="75" height="50" fill="#DEB887"/>
    <rect x="450" y="350" width="75" height="50" fill="#8B4513"/>
    <rect x="525" y="350" width="75" height="50" fill="#DEB887"/>

    <!-- Some chess pieces -->
    <circle cx="37" cy="175" r="20" fill="#000000"/>
    <circle cx="112" cy="325" r="20" fill="#FFFFFF" stroke="#000" stroke-width="2"/>
    <circle cx="262" cy="225" r="20" fill="#000000"/>
    <circle cx="412" cy="275" r="20" fill="#FFFFFF" stroke="#000" stroke-width="2"/>
    <circle cx="562" cy="125" r="20" fill="#000000"/>
  </g>

  <!-- Trophy icon -->
  <g transform="translate(100, 200)">
    <ellipse cx="50" cy="200" rx="40" ry="10" fill="#FFD700"/>
    <rect x="45" y="180" width="10" height="20" fill="#FFD700"/>
    <path d="M 30,120 L 30,180 L 70,180 L 70,120 L 60,100 L 40,100 Z" fill="#FFD700" stroke="#DAA520" stroke-width="2"/>
    <rect x="25" y="100" width="10" height="30" fill="#FFD700"/>
    <rect x="65" y="100" width="10" height="30" fill="#FFD700"/>
  </g>

  <!-- Text overlay -->
  <rect y="550" width="1200" height="80" fill="rgba(0,0,0,0.7)"/>
  <text x="600" y="595" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">
    Półfinał Wojewódzki Szachów - Szkoła Podstawowa nr 2 Kartuzy
  </text>
</svg>
