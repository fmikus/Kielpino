<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <!-- Gradient sky -->
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#B0E0E6;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="water" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#4682B4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1E90FF;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Sky -->
  <rect width="1200" height="400" fill="url(#sky)"/>

  <!-- Water/Lake -->
  <rect y="400" width="1200" height="230" fill="url(#water)"/>

  <!-- Shore -->
  <ellipse cx="600" cy="400" rx="800" ry="50" fill="#228B22"/>

  <!-- Trees -->
  <circle cx="200" cy="350" r="40" fill="#2F4F2F"/>
  <rect x="190" y="350" width="20" height="60" fill="#8B4513"/>

  <circle cx="300" cy="370" r="35" fill="#2F4F2F"/>
  <rect x="290" y="370" width="20" height="50" fill="#8B4513"/>

  <circle cx="900" cy="360" r="38" fill="#2F4F2F"/>
  <rect x="890" y="360" width="20" height="55" fill="#8B4513"/>

  <circle cx="1000" cy="375" r="32" fill="#2F4F2F"/>
  <rect x="990" y="375" width="20" height="45" fill="#8B4513"/>

  <!-- Hotel building outline -->
  <rect x="500" y="280" width="200" height="120" fill="#CD5C5C" stroke="#8B0000" stroke-width="3"/>
  <rect x="510" y="250" width="180" height="30" fill="#A0522D"/>

  <!-- Windows -->
  <rect x="520" y="300" width="30" height="35" fill="#87CEEB"/>
  <rect x="565" y="300" width="30" height="35" fill="#87CEEB"/>
  <rect x="610" y="300" width="30" height="35" fill="#87CEEB"/>
  <rect x="655" y="300" width="30" height="35" fill="#87CEEB"/>

  <rect x="520" y="350" width="30" height="35" fill="#87CEEB"/>
  <rect x="565" y="350" width="30" height="35" fill="#87CEEB"/>
  <rect x="610" y="350" width="30" height="35" fill="#87CEEB"/>
  <rect x="655" y="350" width="30" height="35" fill="#87CEEB"/>

  <!-- Sun -->
  <circle cx="150" cy="100" r="50" fill="#FFD700"/>

  <!-- Text overlay -->
  <rect y="550" width="1200" height="80" fill="rgba(0,0,0,0.6)"/>
  <text x="600" y="595" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">
    Hotel nad Jeziorem Kiełpińskim
  </text>
</svg>
