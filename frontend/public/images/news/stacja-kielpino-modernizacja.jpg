<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <!-- Background sky -->
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E0F6FF;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="1200" height="630" fill="url(#skyGrad)"/>

  <!-- Ground -->
  <rect y="450" width="1200" height="180" fill="#8FBC8F"/>

  <!-- Railway tracks -->
  <!-- Track 1 -->
  <rect x="0" y="470" width="1200" height="8" fill="#696969"/>
  <rect x="0" y="465" width="1200" height="3" fill="#C0C0C0"/>
  <rect x="0" y="481" width="1200" height="3" fill="#C0C0C0"/>

  <!-- Track 2 -->
  <rect x="0" y="520" width="1200" height="8" fill="#696969"/>
  <rect x="0" y="515" width="1200" height="3" fill="#C0C0C0"/>
  <rect x="0" y="531" width="1200" height="3" fill="#C0C0C0"/>

  <!-- Railway sleepers -->
  <rect x="50" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="150" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="250" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="350" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="450" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="550" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="650" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="750" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="850" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="950" y="462" width="15" height="25" fill="#8B4513"/>
  <rect x="1050" y="462" width="15" height="25" fill="#8B4513"/>

  <rect x="50" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="150" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="250" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="350" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="450" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="550" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="650" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="750" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="850" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="950" y="512" width="15" height="25" fill="#8B4513"/>
  <rect x="1050" y="512" width="15" height="25" fill="#8B4513"/>

  <!-- Platform -->
  <rect x="300" y="380" width="600" height="70" fill="#A9A9A9" stroke="#696969" stroke-width="3"/>
  <rect x="310" y="390" width="20" height="60" fill="#FFD700"/>

  <!-- Station building -->
  <rect x="700" y="200" width="250" height="180" fill="#CD5C5C" stroke="#8B0000" stroke-width="3"/>
  <polygon points="700,200 825,130 950,200" fill="#8B4513"/>

  <!-- Windows -->
  <rect x="720" y="230" width="50" height="60" fill="#87CEEB" stroke="#000" stroke-width="2"/>
  <rect x="790" y="230" width="50" height="60" fill="#87CEEB" stroke="#000" stroke-width="2"/>
  <rect x="860" y="230" width="50" height="60" fill="#87CEEB" stroke="#000" stroke-width="2"/>

  <!-- Door -->
  <rect x="780" y="310" width="60" height="70" fill="#654321" stroke="#000" stroke-width="2"/>
  <circle cx="830" cy="345" r="5" fill="#FFD700"/>

  <!-- Train -->
  <g transform="translate(50, 430)">
    <rect x="0" y="0" width="200" height="30" fill="#4169E1" stroke="#000080" stroke-width="2"/>
    <rect x="10" y="5" width="35" height="20" fill="#87CEEB"/>
    <rect x="55" y="5" width="35" height="20" fill="#87CEEB"/>
    <rect x="100" y="5" width="35" height="20" fill="#87CEEB"/>
    <rect x="145" y="5" width="35" height="20" fill="#87CEEB"/>
    <circle cx="40" cy="32" r="8" fill="#2F4F4F"/>
    <circle cx="160" cy="32" r="8" fill="#2F4F4F"/>
  </g>

  <!-- Check mark (modernization approved) -->
  <circle cx="150" cy="150" r="60" fill="#32CD32" opacity="0.8"/>
  <polyline points="120,150 140,170 180,130" fill="none" stroke="white" stroke-width="8" stroke-linecap="round"/>

  <!-- Text overlay -->
  <rect y="550" width="1200" height="80" fill="rgba(0,0,0,0.7)"/>
  <text x="600" y="595" font-family="Arial, sans-serif" font-size="30" font-weight="bold" fill="white" text-anchor="middle">
    Przystanek Kiełpino Kartuskie - Modernizacja Zatwierdzona
  </text>
</svg>
